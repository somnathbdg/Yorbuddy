# Environment Configuration
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbG...xxxx

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change-me-in-production-please-use-random-hex-string
JWT_REFRESH_SECRET=change-me-in-production-please-use-random-hex-string-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Upstash Redis
UPSTASH_REDIS_URL=redis://default:***@host:6379

# Razorpay (TEST MODE for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91
MSG91_AUTH_KEY=xxxxxxxxxx
MSG91_SENDER_ID=YORBUD

# Telegram Bot (for Facebook post approval notifications)
# Get bot token from @BotFather, chat ID from @chatidbot or Telegram API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret token for the inbound Telegram webhook (/api/telegram/webhook).
# Telegram echoes this back in the X-Telegram-Bot-Api-Secret-Token header.
# Required — the webhook fails closed (403) when it is unset. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Email (console provider for development — no real emails sent)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@yorbuddy.in
EMAIL_FROM_NAME=YorBuddy

# Booking expiry (in minutes)
BOOKING_EXPIRY_MINUTES=30

# Google OAuth (optional — for "Continue with Google" feature)
# Create credentials in Google Cloud Console > APIs & Services > Credentials
# Add authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ---------------------------------------------------------------------------
# Test credentials (OPTIONAL — used by the server/test-*.{cjs,mjs} scripts)
# ---------------------------------------------------------------------------
# Test scripts NEVER contain hard-coded passwords. New throwaway accounts are
# registered with a password that is generated at runtime unless you set
# TEST_USER_PASSWORD here.
#
# Tests that must log in to an EXISTING account (e.g. an admin) require the
# variables below; without them those specific checks report SKIP instead of
# guessing a credential. Do not commit real values.
TEST_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

