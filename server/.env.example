# Environment Configuration
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbG...xxxx

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change-me-in-production-please-use-random-hex-string
JWT_REFRESH_SECRET=change-me-in-production-please-use-random-hex-string-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Upstash Redis
UPSTASH_REDIS_URL=redis://default:***@host:6379

# Razorpay (TEST MODE for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91
MSG91_AUTH_KEY=xxxxxxxxxx
MSG91_SENDER_ID=YORBUD
